# Образец настроек. Скопируйте в .env (он не попадает в git) и заполните.
# Значения секретов никогда не коммитятся и не пересылаются в чат.

# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=
# Секрет webhook: латинские буквы, цифры, «_» и «-», до 256 символов.
# Telegram присылает его в заголовке X-Telegram-Bot-Api-Secret-Token; чужие запросы получают 403.
TELEGRAM_WEBHOOK_SECRET=
# Пароль веб-панели /admin, не короче 10 символов (иначе приложение не стартует).
ADMIN_PASSWORD=
# Случайная строка для подписи сессий панели (например, 64 hex-символа).
SECRET_KEY=
# Путь к файлу базы SQLite; относительный путь считается от папки проекта.
# По умолчанию data/bot.sqlite3.
DATABASE_PATH=
# Публичный адрес сайта бота без «/» в конце (для ссылки на демо-страницу /privacy),
# например https://<логин>.pythonanywhere.com
PUBLIC_BASE_URL=

# --- Только для локального деплоя на PythonAnywhere (на хостинге не нужны) ---
# Логин на PythonAnywhere.
PA_USERNAME=
# API-токен PythonAnywhere (Account → API token).
PA_API_TOKEN=
# www.pythonanywhere.com или eu.pythonanywhere.com
PA_HOST=
